# Application
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret

# Database
# SQLite (開発用・デフォルト)
DATABASE_URL=sqlite:///./data/algolens.db
# PostgreSQL (本番用)
# DATABASE_URL=postgresql://user:password@localhost:5432/algolens

# LLM API (将来の自動コード診断機能用)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AtCoder (提出履歴の自動取得用・任意)
ATCODER_USERNAME=
ATCODER_PASSWORD=

# RAG 家庭教師: ChromaDB の保存先（未設定なら backend/data/chroma/）
# OneDrive 等の同期フォルダ外を推奨
CHROMA_DIR=

# 解答を置くフォルダ（未設定なら AtCorder/submissions/。絶対パスで指定）
#   scripts/new_contest.py が <フォルダ>/abc477/c.py, c.txt を作り、振り返りはここから読む
#   （ファイル名に問題IDを含む形 abc476_d.py も読める。ない問題は振り返りページで貼り付ける）
SUBMISSIONS_DIR=

# 修正版を最大サイズの入力で測るときの PyPy（AtCoder と同じ PyPy 3.11-v7.3.20 を推奨）
#   未設定なら PATH の pypy3 / pypy を探し、なければ CPython で制限時間を 5 倍に緩めて測る
#   例: PYPY_PATH=C:\pypy\pypy3.11-v7.3.20-win64\pypy3.exe
PYPY_PATH=
